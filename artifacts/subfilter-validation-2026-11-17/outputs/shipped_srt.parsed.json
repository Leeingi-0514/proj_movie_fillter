  "cues": [
    {
      "id": 1,
      "start_ms": 5000,
      "end_ms": 7500,
      "text": "여기가 그 산장이야?"
    },
    {
      "id": 2,
      "start_ms": 8000,
      "end_ms": 10000,
      "text": "응, 오늘 밤은 여기서 자자."
    },
    {
      "id": 3,
      "start_ms": 40000,
      "end_ms": 42000,
      "text": "방금 무슨 소리 들었어?"
    },
    {
      "id": 4,
      "start_ms": 42500,
      "end_ms": 44000,
      "text": "[문이 삐걱거리는 소리]"
    },
    {
      "id": 5,
      "start_ms": 45000,
      "end_ms": 46500,
      "text": "[비명]"
    },
    {
      "id": 6,
      "start_ms": 47000,
      "end_ms": 49000,
      "text": "살려줘! 귀신이야!"
    },
    {
      "id": 7,
      "start_ms": 150000,
      "end_ms": 152000,
      "text": "너 오늘 진짜 예쁘다."
    },
    {
      "id": 8,
      "start_ms": 153000,
      "end_ms": 155000,
      "text": "(키스하는 소리) / 침대로 가자."
    },
    {
      "id": 9,
      "start_ms": 250000,
      "end_ms": 252000,
      "text": "칼 내려놔! 죽여버린다!"
    },
    {
      "id": 10,
      "start_ms": 252500,
      "end_ms": 253500,
      "text": "[총성]"
    },
    {
      "id": 11,
      "start_ms": 254000,
      "end_ms": 256000,
      "text": "피가... 피가 너무 많이 나."
    }
  ]
}
